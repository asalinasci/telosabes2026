# ---------- Compilacion / build ----------
# Maven
target/
!**/src/main/**/target/
!**/src/test/**/target/
# Gradle / Ant
build/
!**/src/main/**/build/
!**/src/test/**/build/
# Salida de IDEs
out/
bin/
*.class
*.jar
*.war
*.ear
*.nar
# El wrapper de Maven SI debe subirse
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ---------- Gradle ----------
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ---------- Maven ----------
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# ---------- Variables de entorno / secretos ----------
.env
*.env
*.keystore
*.jks
src/main/resources/application-secret*.properties
src/main/resources/application-local.properties

# ---------- Archivos de base de datos ----------
*.db
*.mdb
*.log

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.iws
*.ipr

# ---------- Eclipse / STS ----------
.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache

# ---------- VS Code ----------
.vscode/

