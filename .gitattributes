# El lanzador de Maven y los scripts de shell tienen que llevar saltos de
# linea LF tambien cuando se clonan en Windows: si no, fallan con
# "/bin/bash^M: bad interpreter".
/mvnw text eol=lf
*.sh text eol=lf

# Los .cmd y .ps1 de Windows, en cambio, van con CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
