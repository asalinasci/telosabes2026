[Unit]
Description=telosabes2026 (Spring Boot + MariaDB + Thymeleaf)
Documentation=https://github.com/asalinasci/telosabes2026
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=telosabes2026
Group=telosabes2026
WorkingDirectory=/opt/telosabes2026

# DB_USER y DB_PASSWORD (chmod 600, solo lo lee root)
EnvironmentFile=/etc/telosabes2026.env

# Perfil de produccion: escucha solo en 127.0.0.1:8080 (delante va Nginx)
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /opt/telosabes2026/telosabes2026.jar --spring.profiles.active=prod

# 143 = SIGTERM: parada limpia con "systemctl stop"
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# Endurecimiento basico del servicio
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
